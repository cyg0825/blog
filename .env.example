# Local environment variables (copy to .env.local for your local setup, do not commit .env.local)

# === 数据库配置 ===
# H2模式无需配置，MySQL模式使用以下配置
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# === JWT配置 ===
JWT_SECRET=BlogSystemSecretKeyChangeMe

# === AI配置（可选，用于评论智能审核和文章AI总结）===
AI_API_URL=https://token.sensenova.cn/v1/chat/completions
AI_API_KEY=your_ai_api_key_here
AI_MODEL=sensenova-6.7-flash-lite